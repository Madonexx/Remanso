[node name="AlliedNeighbors" type="Node3D" parent="." unique_id=502435445]

[node name="NeighborChacho" parent="AlliedNeighbors" unique_id=459466693 instance=ExtResource("37_nboat")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -10, 0, 8)
fisher_role = "Pescador Artesanal de la Cooperativa"
dialogue_text = "\"¡Qué hacés, hermano! En los Pozos Profundos (anillo ámbar grande) andan los Surubíes y Patíes pesados, pero tironean lindo: comprale la Caña de tacuara a La Negra Viera antes de pelearlos. Y ojo a la noche por la laguna oeste que anda patrullando 'El Sábalo Negro'.\""

[node name="NeighborMarta" parent="AlliedNeighbors" unique_id=1927471878 instance=ExtResource("37_nboat")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -30, 0, -24)
fisher_name = "Doña Marta (Reddera Isleña)"
fisher_role = "Bióloga Comunitaria y Reddera"
dialogue_text = "\"¡Buen día, che! En los Remansos de Juncos están saltando el Dorado y el Pacú. Acordate del convenio científico: si los marcás y devolvés al agua te pagan entre $55 y $85 en el acto y subís +4% la Salud del Río. De noche traete machete para cortar los tramayos del Riacho Norte.\""
portrait_icon = "res://Used_Assets/ui/CatchingNet.png"

[node name="NeighborGuri" parent="AlliedNeighbors" unique_id=1128906210 instance=ExtResource("37_nboat")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 0, 28)
fisher_name = "El Gurí Maidana (Costa Este)"
fisher_role = "Veedor Ribereño"
dialogue_text = "\"¡Guarda con el canal principal, chamigo! Cuando suena la sirena del buque ultramarino se viene una pared de agua hacia los riachos: metete en los juncales o encarala bien de proa para reducir el golpe un 75%. Y a la noche usá el Visor [F] para escrachar al remolcador 'Paraná Sur'.\""
portrait_icon = "res://Used_Assets/ui/Eye.png"

